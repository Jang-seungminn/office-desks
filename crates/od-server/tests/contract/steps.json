      "kind": "http",
      "method": "POST",
      "path": "/api/worktree",
      "body": {
        "deskId": "${WT_DESK}",
        "workspaceStatus": "review",
        "comment": "  a 　 b  "
      }
    },
    {
      "name": "manage-worktree-comment-null",
      "group": "manage",
      "kind": "http",
      "method": "POST",
      "path": "/api/worktree",
      "body": {
        "deskId": "${WT_DESK}",
        "comment": null
      }
    },
    {
      "name": "manage-wait-comment",
      "group": "manage",
      "kind": "waitFor",
      "path": [
        "desks",
        {
          "where": {
            "name": "feat1"
          }
        },
        "comment"
      ],
      "equals": "null"
    },
    {
      "name": "manage-snapshot-board",
      "group": "manage",
      "kind": "http",
      "method": "GET",
      "path": "/api/snapshot"
    },
    {
      "name": "manage-worktree-bad-json",
      "group": "manage",
      "kind": "http",
      "method": "POST",
      "path": "/api/worktree",
      "bodyRaw": "{",
      "compare": "status"
    },
    {
      "name": "manage-worktree-null-body",
      "group": "manage",
      "kind": "http",
      "method": "POST",
      "path": "/api/worktree",
      "bodyRaw": "null"
    },
    {
      "name": "manage-worktree-too-large",
      "group": "manage",
      "kind": "http",
      "method": "POST",
      "path": "/api/worktree",
      "bodyRepeat": {
        "prefix": "{\"deskId\":\"",
        "char": "a",
        "count": 63988,
        "suffix": "\"}"
      }
    },
    {
      "name": "manage-org-save",
      "group": "manage",
      "kind": "http",
      "method": "POST",
      "path": "/api/org",
      "body": {
        "departments": [
          {
            "id": "dev",
            "name": "개발",
            "theme": "dev"
          }
        ]
      },
      "headers": {
        "content-type": null
      }
    },
    {
      "name": "manage-ws-org",
      "group": "manage",
      "kind": "wsExpect",
      "id": "main",
      "type": "org",
      "after": "manage-org-save"
    },
    {
      "name": "manage-org-invalid",
