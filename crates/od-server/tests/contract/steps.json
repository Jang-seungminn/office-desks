{
  "version": 1,
  "setup": {
    "repo": {
      "files": {
        "README.md": "# contract\n",
        "src/a.txt": "one\ntwo\n"
      },
      "commit": {
        "message": "init",
        "name": "contract",
        "email": "contract@example.invalid",
        "date": "2026-01-01T00:00:00Z"
      },
      "after": {
        "src/a.txt": "one\nTWO\nthree\n",
        "notes.md": "hi\n"
      }
    },
    "files": {
      "home/.claude/commands/hello.md": "---\ndescription: Say hello\n---\nHello"
    },
    "dirs": [
      "claude/projects/scratch"
    ],
    "uploads": {
      "contract-shot.png": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAACklEQVR4nGMAAQAABQABDQottAAAAABJRU5ErkJggg=="
    }
  },
  "steps": [
    {
      "name": "guard-host-evil",
      "group": "guard",
      "kind": "http",
      "method": "GET",
      "path": "/api/snapshot",
      "headers": {
        "Host": "evil.example:${PORT}"
      }
    },
    {
      "name": "guard-origin-evil",
      "group": "guard",
      "kind": "http",
      "method": "GET",
      "path": "/api/snapshot",
      "headers": {
        "Origin": "https://evil.example"
      }
    },
    {
      "name": "guard-origin-null",
      "group": "guard",
      "kind": "http",
      "method": "GET",
      "path": "/api/snapshot",
      "headers": {
        "Origin": "null"
      }
    },
    {
      "name": "guard-fetch-site-cross-site",
      "group": "guard",
      "kind": "http",
      "method": "GET",
      "path": "/api/snapshot",
      "headers": {
        "Sec-Fetch-Site": "cross-site"
      }
    },
    {
      "name": "guard-fetch-site-same-site",
      "group": "guard",
      "kind": "http",
      "method": "GET",
      "path": "/api/snapshot",
      "headers": {
        "Sec-Fetch-Site": "same-site"
      }
    },
    {
      "name": "guard-fetch-dest-iframe",
      "group": "guard",
      "kind": "http",
      "method": "GET",
      "path": "/api/snapshot",
      "headers": {
        "Sec-Fetch-Dest": "iframe"
      }
    },
    {
      "name": "guard-hook-origin-evil",
      "group": "guard",
      "kind": "http",
      "method": "POST",
      "path": "/hook/x?token=y",
      "body": {},
      "headers": {
        "Origin": "https://evil.example"
      }
    },
    {
      "name": "guard-ws-origin-evil",
      "group": "guard",
      "kind": "wsReject",
      "path": "/ws",
      "headers": {
        "Origin": "https://evil.example"
      }
    },
    {
      "name": "guard-ws-query",
      "group": "guard",
      "kind": "wsReject",
      "path": "/ws?x=1"
    },
    {
      "name": "empty-ws-open",
      "group": "empty",
      "kind": "wsOpen",
      "id": "main",
      "count": 4
    },
    {
      "name": "empty-snapshot",
      "group": "empty",
      "kind": "http",
      "method": "GET",
      "path": "/api/snapshot"
    },
    {
      "name": "empty-org",
      "group": "empty",
      "kind": "http",
      "method": "GET",
      "path": "/api/org"
    },
    {
      "name": "empty-get-nope",
      "group": "empty",
      "kind": "http",
      "method": "GET",
      "path": "/api/nope"
    },
    {
      "name": "empty-head-snapshot",
      "group": "empty",
      "kind": "http",
      "method": "HEAD",
      "path": "/api/snapshot"
    },
    {
      "name": "empty-post-nope",
      "group": "empty",
      "kind": "http",
      "method": "POST",
      "path": "/api/nope",
      "body": {}
