        "id"
      ],
      "capture": {
        "MAIN_DESK": [
          "desks",
          0,
          "id"
        ],
        "REPO_ID": [
          "desks",
          0,
          "repoId"
        ]
      }
    },
    {
      "name": "manage-hire-unknown-agent",
      "group": "manage",
      "kind": "http",
      "method": "POST",
      "path": "/api/hire",
