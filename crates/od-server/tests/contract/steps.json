        "desks",
        {
          "where": {
            "name": "feat1"
          }
        },
        "agents",
        0,
        "id"
      ],
      "capture": {
        "WT_DESK": [
          "desks",
          {
            "where": {
              "name": "feat1"
            }
          },
          "id"
        ],
        "AGENT": [
          "desks",
          {
            "where": {
              "name": "feat1"
            }
          },
          "agents",
          0,
          "id"
        ],
        "HANDLE": [
          "desks",
          {
            "where": {
              "name": "feat1"
            }
          },
          "agents",
          0,
          "terminalHandle"
        ]
      }
    },
    {
      "name": "manage-wait-main-changes",
      "group": "manage",
      "kind": "waitFor",
      "path": [
        "desks",
        {
          "where": {
            "isMain": true
          }
        },
        "changes",
        "files"
      ]
    },
    {
      "name": "manage-wait-feat1-changes",
      "group": "manage",
      "kind": "waitFor",
      "path": [
        "desks",
        {
          "where": {
            "name": "feat1"
          }
        },
        "changes",
        "files"
      ]
    },
    {
      "name": "manage-settle",
      "group": "manage",
      "kind": "sleep",
      "ms": 2700
    },
    {
      "name": "manage-snapshot",
      "group": "manage",
      "kind": "http",
      "method": "GET",
      "path": "/api/snapshot"
    },
    {
      "name": "manage-worktree-unknown",
