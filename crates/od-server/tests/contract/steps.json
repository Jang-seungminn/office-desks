        "workspaceStatus": "Bad"
      }
    },
    {
      "name": "manage-worktree-long-comment",
      "group": "manage",
      "kind": "http",
      "method": "POST",
      "path": "/api/worktree",
      "body": {
        "deskId": "${WT_DESK}",
        "comment": "가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가"
      }
    },
    {
      "name": "manage-worktree-nothing",
