    },
    {
      "name": "hook-seed-transcript",
      "group": "hook",
      "kind": "seedTranscript",
      "append": [
        "{\"type\":\"assistant\",\"timestamp\":\"2026-10-04T09:00:15.000Z\",\"message\":{\"role\":\"assistant\",\"model\":\"claude-opus-5-5\",\"content\":[{\"type\":\"text\",\"text\":\"Saved ![shot](${ROOT}/shot.png)\"}]}}"
      ]
    },
    {
      "name": "hook-write-shot",
      "group": "hook",
