      "path": "${ROOT}/shot.png",
      "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAACklEQVR4nGMAAQAABQABDQottAAAAABJRU5ErkJggg=="
    },
    {
      "name": "hook-session-start",
      "group": "hook",
      "kind": "http",
      "method": "POST",
      "path": "/hook/${AGENT|uri}?token=${TOKEN}",
      "body": {
        "hook_event_name": "SessionStart",
        "session_id": "${SID}",
        "transcript_path": "${ROOT}/claude/projects/scratch/${SID}.jsonl"
      }
    },
    {
      "name": "hook-wrong-token",
      "group": "hook",
